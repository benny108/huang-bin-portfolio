---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactPanel from "@/components/ContactPanel.astro";
import type { Lang } from "@/lib/models";

export async function getStaticPaths() {
  const entries = await getCollection("projects");
  return entries.map((entry) => ({
    params: { lang: entry.data.lang, slug: entry.data.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<"projects"> };
const lang = entry.data.lang as Lang;
const { Content } = await render(entry);
const d = entry.data;
---

<BaseLayout lang={lang} title={`${d.title}｜${lang === "zh" ? "黄彬" : "Bin Huang"}`} description={d.summary} article image="/og.png">
  <header class="detail-lede">
    <div class="shell">
      <div class="kicker">{d.role} · {d.period}</div>
      <h1>{d.title}</h1>
      <p>{d.summary}</p>
      <div class="detail-metrics">{d.metrics.map((metric) => <span>{metric}</span>)}</div>
    </div>
  </header>
  <section class="content-page">
    <div class="shell article-shell">
      <article class="prose"><Content /></article>
      <aside class="article-meta">
        <dl>
          <dt>{lang === "zh" ? "角色" : "Role"}</dt><dd>{d.role}</dd>
          <dt>{lang === "zh" ? "时间" : "Period"}</dt><dd>{d.period}</dd>
          <dt>{lang === "zh" ? "技术标签" : "Topics"}</dt><dd>{d.tags.join(" · ")}</dd>
          <dt>{lang === "zh" ? "公开边界" : "Public boundary"}</dt><dd>{d.confidentiality}</dd>
        </dl>
      </aside>
    </div>
  </section>
  <ContactPanel lang={lang} />
</BaseLayout>
