---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { copy, languages } from "@/lib/i18n";
import { getLocalizedCollection } from "@/lib/content";
import type { Lang } from "@/lib/models";
import "@/styles/academic-home.css";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const t = copy[lang];
const alternate = lang === "zh" ? "en" : "zh";
const publicationOrder = ["skillscope", "radad", "finance-agent", "tcm-llm", "firewallm"];
const publications = (await getLocalizedCollection("publications", lang))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => publicationOrder.indexOf(a.data.slug) - publicationOrder.indexOf(b.data.slug));
const projectOrder = [
  "tcm-knowledge-graph",
  "xfusion-agent-profile",
  "inference-production-gate",
  "nebula-overseas-gtm"
];
const projects = (await getLocalizedCollection("projects", lang))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => projectOrder.indexOf(a.data.slug) - projectOrder.indexOf(b.data.slug));
const writing = (await getLocalizedCollection("writing", lang))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const statusLabels = lang === "zh"
  ? {
      published: "已发表",
      accepted: "已录用",
      under_review: "审稿中",
      manuscript: "研究稿",
      shared_task: "共享任务"
    }
  : {
      published: "Published",
      accepted: "Accepted",
      under_review: "Under Review",
      manuscript: "Manuscript",
      shared_task: "Shared Task"
    };
const interests = lang === "zh"
  ? ["多 Agent 协作", "RAG 与知识工程", "医疗 AI", "生成式 AI 系统", "推理优化"]
  : ["Multi-Agent Systems", "RAG & Knowledge Engineering", "Medical AI", "Generative AI Systems", "Inference Optimization"];
const briefFacts = lang === "zh"
  ? [["3.98", "本科 GPA / 4.00"], ["1 / 127", "专业排名"], ["2024", "国家奖学金"]]
  : [["3.98", "B.Eng. GPA / 4.00"], ["1 / 127", "Program rank"], ["2024", "National Scholarship"]];
const capabilities = lang === "zh"
  ? [
      {
        index: "01",
        label: "RESEARCH",
        title: "研究方法和实验",
        description: "我主要研究多 Agent 和医疗 AI。工作包括问题定义、方法设计、实验分析和论文写作。",
        metrics: [["5+", "第一作者研究"], ["8.5×", "BLEU-4 提升"]],
        href: "/zh/research/"
      },
      {
        index: "02",
        label: "ENGINEERING",
        title: "系统实现和性能",
        description: "我做过知识图谱、RAG、Agent Runtime 和生成模型推理优化，习惯把实验代码整理成能反复运行的系统。",
        metrics: [["33,214", "知识图谱实体"], ["2.35×", "推理加速"]],
        href: "/zh/projects/"
      },
      {
        index: "03",
        label: "PRODUCT",
        title: "产品和客户",
        description: "做过海外客户筛选、需求沟通、产品演示和现场拓展。这段经历让我更在意技术是否真的有人愿意使用。",
        metrics: [["12万+", "公开内容播放"], ["8台 / 4万", "销量 / 净利润"]],
        href: "/zh/projects/nebula-overseas-gtm/"
      }
    ]
  : [
      {
        index: "01",
        label: "RESEARCH",
        title: "Research methods and experiments",
        description: "I mainly work on multi-agent systems and medical AI, including problem definition, method design, experiments, and paper writing.",
        metrics: [["5+", "first-author works"], ["8.5×", "BLEU-4 gain"]],
        href: "/en/research/"
      },
      {
        index: "02",
        label: "ENGINEERING",
        title: "Systems and performance",
        description: "I have built knowledge graphs, RAG pipelines, Agent Runtime components, and inference benchmarks, then turned the experiments into repeatable systems.",
        metrics: [["33,214", "knowledge-graph entities"], ["2.35×", "inference speedup"]],
        href: "/en/projects/"
      },
      {
        index: "03",
        label: "PRODUCT",
        title: "Products and customers",
        description: "I have worked on overseas customer research, product demos, and field outreach. It taught me to care whether someone will actually use what we build.",
        metrics: [["120K+", "public content views"], ["8 / ¥40K", "units / net profit"]],
        href: "/en/projects/nebula-overseas-gtm/"
      }
    ];
const education = t.timeline
  .filter((item) => lang === "zh" ? item.title.includes("大学") : item.title.includes("University"))
  .map((item) => ({
    ...item,
    logo: item.title.includes("郑州") || item.title.includes("Zhengzhou")
      ? "/education/zzu.png"
      : "/education/gzhu.jpg",
    logoAlt: item.title.includes("郑州") || item.title.includes("Zhengzhou")
      ? (lang === "zh" ? "郑州大学校徽" : "Zhengzhou University logo")
      : (lang === "zh" ? "广州大学校徽" : "Guangzhou University logo")
  }));
---

<BaseLayout lang={lang} image="/og.png" minimal>
  <section class="academic-home">
    <div class="shell academic-home-grid">
      <aside class="academic-sidebar">
        <p class="academic-profile-kicker">
          <span></span>{lang === "zh" ? "2026 · 实习 / 合作" : "2026 · INTERNSHIPS / COLLABORATION"}
        </p>
        <img
          class="academic-avatar"
          src="/profile/huang-bin-avatar.jpg"
          alt={lang === "zh" ? "黄彬个人照片" : "Portrait of Bin Huang"}
          width="640"
          height="640"
          loading="eager"
          fetchpriority="high"
        />
        <h1>{t.hero.name}</h1>
        <p class="academic-role">{t.hero.role}</p>
        <p class="academic-affiliation">
          {lang === "zh" ? "郑州大学 NLP 实验室 · 硕士在读" : "M.Sc. Student · ZZU NLP Lab"}
        </p>
        <p class="academic-sidebar-bio">
          {lang === "zh"
            ? "最近主要在做 Agent、RAG 和医疗 AI。除了写论文，我也写代码、跑系统，偶尔去和真实客户聊需求。"
            : "I currently work on Agents, RAG, and medical AI. I write papers, build systems, and occasionally talk to real customers about what they need."}
        </p>
        <div class="academic-facts" aria-label={lang === "zh" ? "代表性成果" : "Selected outcomes"}>
          {briefFacts.map(([value, label]) => (
            <span><strong>{value}</strong>{label}</span>
          ))}
        </div>
        <div class="academic-links">
          <a href="mailto:1084893712@qq.com">Email</a>
          <a href="https://github.com/benny108" target="_blank" rel="noreferrer">GitHub</a>
          <a href="https://www.zhihu.com/people/42-29-40-28" target="_blank" rel="noreferrer">知乎</a>
          <a href="https://space.bilibili.com/3493106871700084" target="_blank" rel="noreferrer">Bilibili</a>
        </div>
        <p class="academic-availability"><span></span>{t.hero.status}<br />{t.hero.location}</p>
      </aside>

      <main class="academic-main">
        <nav class="academic-nav" aria-label={lang === "zh" ? "主导航" : "Main navigation"}>
          <a class="active" href={`/${lang}/`}>{t.nav.home}</a>
          <a href={`/${lang}/research/`}>{t.nav.research}</a>
          <a href={`/${lang}/projects/`}>{t.nav.projects}</a>
          <a href={`/${lang}/writing/`}>{t.nav.writing}</a>
          <a href={`/${lang}/about/`}>{t.nav.about}</a>
          <a
            class="academic-lang"
            href={`/${alternate}/`}
            data-lang-switch
            data-target-lang={alternate}
          >
            {lang === "zh" ? "EN" : "中文"}
          </a>
          <button
            class="academic-audio-toggle"
            type="button"
            aria-pressed="false"
            data-ambient-toggle
            data-label-off={lang === "zh" ? "背景音乐" : "Music"}
            data-label-on={lang === "zh" ? "音乐播放中" : "Music on"}
            title={lang === "zh" ? "播放一段很轻的背景音乐，默认关闭" : "Play quiet background music; off by default"}
          >
            <span class="academic-audio-bars" aria-hidden="true"><i></i><i></i><i></i></span>
            <span data-ambient-label>{lang === "zh" ? "背景音乐" : "Music"}</span>
          </button>
        </nav>

        <section class="academic-section academic-intro">
          <p class="academic-eyebrow">LLM · AGENT · MEDICAL AI</p>
          <h2>
            {lang === "zh"
              ? "我研究 Agent 和医疗 AI，也负责把方法做成能运行的系统。"
              : "I work on Agents and medical AI, then carry the method into a working system."}
          </h2>
          <p class="academic-lead">
            {lang === "zh"
              ? "我目前在郑州大学 NLP 实验室读硕士。手上的工作通常从一个研究问题开始，最后要落到实验、代码和可以复现的结果上。"
              : "I am an M.Sc. student at the ZZU NLP Lab. My work usually starts with a research question and ends with experiments, code, and a result that can be reproduced."}
          </p>
          <p>
            {lang === "zh"
              ? "过去几年，我做过角色非对称的胸部 CT 报告生成，搭过包含 33,214 个实体的中医知识图谱，也测试过企业 Agent 配置和生成模型推理加速。还有一段海外产品经历，让我开始认真考虑技术怎么被客户理解、怎么真正卖出去。"
              : "I have worked on role-asymmetric chest CT report generation, built a TCM knowledge graph with 33,214 entities, and tested enterprise Agent configuration and generative-model inference. An overseas product role also taught me how customers understand technology—and what it takes to sell it."}
          </p>
          <div class="academic-intro-actions">
            <a class="academic-primary-link" href={`/${lang}/research/`}>
              {lang === "zh" ? "查看研究成果" : "Explore research"} <span>↗</span>
            </a>
            <a href={`/${lang}/projects/`}>
              {lang === "zh" ? "查看工程案例" : "View engineering cases"} <span>→</span>
            </a>
          </div>
        </section>

        <section class="academic-section academic-capability-band" aria-labelledby="capability-title">
          <div class="academic-capability-heading">
            <p>{lang === "zh" ? "我做过的事情，大致可以分成三类" : "My work falls into three areas"}</p>
            <h2 id="capability-title">
              {lang === "zh" ? "研究、工程和产品" : "Research, engineering, and product"}
            </h2>
          </div>
          <div class="academic-capability-grid">
            {capabilities.map((capability) => (
              <a class="academic-capability-card" href={capability.href}>
                <div class="academic-capability-index">
                  <span>{capability.index}</span>
                  <small>{capability.label}</small>
                </div>
                <h3>{capability.title}</h3>
                <p>{capability.description}</p>
                <div class="academic-capability-metrics">
                  {capability.metrics.map(([value, label]) => (
                    <span><strong>{value}</strong><small>{label}</small></span>
                  ))}
                </div>
                <b aria-hidden="true">↗</b>
              </a>
            ))}
          </div>
        </section>

        <section class="academic-section">
          <h2 class="academic-section-title">{lang === "zh" ? "研究兴趣" : "Research Interests"}</h2>
          <div class="academic-interest-list">
            {interests.map((interest) => <span>{interest}</span>)}
          </div>
        </section>

        <section class="academic-section">
          <div class="academic-section-head">
            <h2 class="academic-section-title">{lang === "zh" ? "教育经历" : "Education"}</h2>
            <a href={`/${lang}/about/`}>{lang === "zh" ? "完整经历" : "Full profile"} →</a>
          </div>
          <div class="academic-education-list">
            {education.map((item) => (
              <article>
                <img src={item.logo} alt={item.logoAlt} width="252" height="252" loading="lazy" />
                <time>{item.period}</time>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.meta}</p>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="academic-section">
          <div class="academic-section-head">
            <h2 class="academic-section-title">{lang === "zh" ? "精选研究" : "Selected Research"}</h2>
            <a href={`/${lang}/research/`}>{lang === "zh" ? "全部研究" : "View all"} →</a>
          </div>
          <div class="academic-list">
            {publications.slice(0, 5).map((entry) => (
              <article class="academic-list-item">
                <div>
                  <h3><a href={`/${lang}/research/${entry.data.slug}/`}>{entry.data.title}</a></h3>
                  <p>{entry.data.summary}</p>
                </div>
                <div class="academic-list-meta">
                  <span>{entry.data.year}</span>
                  <span>{entry.data.role}</span>
                  <span>{statusLabels[entry.data.status]}</span>
                  {entry.data.metrics[0] && <strong>{entry.data.metrics[0]}</strong>}
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="academic-section academic-split">
          <div>
            <div class="academic-section-head">
              <h2 class="academic-section-title">{lang === "zh" ? "工程与产品" : "Engineering & Product"}</h2>
              <a href={`/${lang}/projects/`}>{lang === "zh" ? "全部项目" : "View all"} →</a>
            </div>
            <div class="academic-compact-list">
              {projects.slice(0, 3).map((entry) => (
                <a href={`/${lang}/projects/${entry.data.slug}/`}>
                  <span>{entry.data.title}</span>
                  <small>{entry.data.metrics[0]}</small>
                </a>
              ))}
            </div>
          </div>
          <div>
            <div class="academic-section-head">
              <h2 class="academic-section-title">{lang === "zh" ? "近期写作" : "Recent Writing"}</h2>
              <a href={`/${lang}/writing/`}>{lang === "zh" ? "全部文章" : "View all"} →</a>
            </div>
            <div class="academic-compact-list">
              {writing.slice(0, 2).map((entry) => (
                <a href={`/${lang}/writing/${entry.data.slug}/`}>
                  <span>{entry.data.title}</span>
                  <small>{entry.data.readingMinutes} MIN</small>
                </a>
              ))}
              <a href={`/${lang}/about/`}>
                <span>{lang === "zh" ? "教育、经历、荣誉与专利" : "Education, experience, awards & patents"}</span>
                <small>ABOUT</small>
              </a>
            </div>
          </div>
        </section>

        <section class="academic-note">
          <p>
            {lang === "zh"
              ? "开放 LLM / Agent 实习、研究合作与技术交流。"
              : "Open to LLM / Agent internships, research collaboration, and technical exchange."}
          </p>
          <a href="mailto:1084893712@qq.com">{lang === "zh" ? "联系我" : "Contact me"} →</a>
        </section>

        <footer class="academic-footer">
          <span>© {new Date().getFullYear()} {lang === "zh" ? "黄彬" : "Bin Huang"}</span>
          <span>
            {lang === "zh" ? "视觉参考" : "Inspired by"}{" "}
            <a href="https://github.com/rubzip/academic-portfolio-astro" target="_blank" rel="noreferrer">
              Academic Portfolio Astro
            </a>
          </span>
        </footer>
      </main>
    </div>
  </section>
  <script is:inline>
    (() => {
      const button = document.querySelector("[data-ambient-toggle]");
      if (!button || button.dataset.bound === "true") return;
      button.dataset.bound = "true";

      let context;
      let master;
      let timer;
      let active = false;
      let chordIndex = 0;
      const chords = [
        [174.61, 220, 261.63],
        [196, 246.94, 293.66],
        [164.81, 220, 329.63],
        [174.61, 233.08, 293.66]
      ];

      const updateButton = () => {
        const label = button.querySelector("[data-ambient-label]");
        const nextLabel = active ? button.dataset.labelOn : button.dataset.labelOff;
        button.setAttribute("aria-pressed", String(active));
        if (label && nextLabel) label.textContent = nextLabel;
      };

      const playChord = () => {
        if (!context || !master || !active) return;
        const now = context.currentTime;
        const frequencies = chords[chordIndex % chords.length];
        chordIndex += 1;

        frequencies.forEach((frequency, noteIndex) => {
          const oscillator = context.createOscillator();
          const gain = context.createGain();
          oscillator.type = noteIndex === 1 ? "triangle" : "sine";
          oscillator.frequency.setValueAtTime(frequency, now);
          oscillator.detune.setValueAtTime((noteIndex - 1) * 3, now);
          gain.gain.setValueAtTime(0.0001, now);
          gain.gain.exponentialRampToValueAtTime(noteIndex === 1 ? 0.014 : 0.009, now + 1.1);
          gain.gain.exponentialRampToValueAtTime(0.0001, now + 5.8);
          oscillator.connect(gain);
          gain.connect(master);
          oscillator.start(now);
          oscillator.stop(now + 6);
        });
      };

      const start = async () => {
        if (!window.AudioContext) return;
        if (!context) {
          context = new window.AudioContext();
          master = context.createGain();
          master.gain.value = 0.5;
          master.connect(context.destination);
        }
        await context.resume();
        active = true;
        master.gain.setTargetAtTime(0.5, context.currentTime, 0.18);
        updateButton();
        playChord();
        timer = window.setInterval(playChord, 6500);
      };

      const stop = () => {
        if (timer) window.clearInterval(timer);
        timer = undefined;
        active = false;
        updateButton();
        if (context && master) {
          master.gain.setTargetAtTime(0.0001, context.currentTime, 0.08);
          window.setTimeout(() => context?.suspend(), 260);
        }
      };

      button.addEventListener("click", () => {
        if (active) stop();
        else start();
      });
      document.addEventListener("visibilitychange", () => {
        if (!context || !active) return;
        if (document.hidden) context.suspend();
        else context.resume();
      });
      window.addEventListener("pagehide", stop);
    })();
  </script>
</BaseLayout>
