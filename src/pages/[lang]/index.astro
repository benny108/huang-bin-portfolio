---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import PublicationCard from "@/components/PublicationCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import AwardGallery from "@/components/AwardGallery.astro";
import ContactPanel from "@/components/ContactPanel.astro";
import { copy, languages, platforms } from "@/lib/i18n";
import { getLocalizedCollection } from "@/lib/content";
import type { Lang } from "@/lib/models";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const t = copy[lang];
const publications = (await getLocalizedCollection("publications", lang))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => b.data.year - a.data.year);
const projectOrder = [
  "tcm-knowledge-graph",
  "xfusion-agent-profile",
  "inference-production-gate",
  "nebula-overseas-gtm"
];
const projects = (await getLocalizedCollection("projects", lang))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => projectOrder.indexOf(a.data.slug) - projectOrder.indexOf(b.data.slug));
const writing = (await getLocalizedCollection("writing", lang))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const awards = (await getLocalizedCollection("awards", lang))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.year - a.data.year);
---

<BaseLayout lang={lang} image="/og.png">
  <section class="home-hero">
    <div class="shell hero-grid">
      <div>
        <div class="eyebrow">{t.hero.eyebrow}</div>
        <div class="hero-name">
          <strong>{t.hero.name}</strong>
          <span>{t.hero.role}</span>
        </div>
        <h1>{t.hero.headline}</h1>
        <p class="hero-body">{t.hero.body}</p>
        <div class="hero-meta">
          <span>{t.hero.status}</span>
          <span>{t.hero.location}</span>
        </div>
        <div class="hero-actions">
          <a class="button primary" href={`/${lang}/research/`}>{t.hero.primary}<span aria-hidden="true">↗</span></a>
          <a class="button secondary" href={`/${lang}/projects/`}>{t.hero.secondary}<span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="hero-visual" aria-label={lang === "zh" ? "黄彬研究方向示意" : "Bin Huang research focus"}>
        <div class="identity-orbit">
          <img
            class="profile-avatar profile-avatar-hero"
            src="/profile/huang-bin-avatar.jpg"
            alt={lang === "zh" ? "黄彬个人照片" : "Portrait of Bin Huang"}
            width="640"
            height="640"
            loading="eager"
            fetchpriority="high"
          />
          <span class="orbit-label">MULTI-AGENT</span>
          <span class="orbit-label">RAG</span>
          <span class="orbit-label">MEDICAL AI</span>
          <span class="orbit-label">SYSTEMS</span>
        </div>
      </div>
    </div>
  </section>

  <section class="metric-band">
    <div class="shell metric-grid">
      {t.metrics.map(([value, label]) => <div class="metric-item"><strong>{value}</strong><span>{label}</span></div>)}
    </div>
  </section>

  <section class="section section-dark">
    <div class="shell">
      <SectionHeading
        kicker={t.sections.researchKicker}
        title={t.sections.researchTitle}
        body={t.sections.researchBody}
        href={`/${lang}/research/`}
        linkLabel={t.sections.viewAll}
      />
      <div class="publication-grid">
        {publications.map((entry) => <PublicationCard entry={entry} lang={lang} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeading
        kicker={t.sections.projectKicker}
        title={t.sections.projectTitle}
        body={t.sections.projectBody}
        href={`/${lang}/projects/`}
        linkLabel={t.sections.viewAll}
      />
      <div class="project-stack">
        {projects.map((entry, index) => <ProjectCard entry={entry} lang={lang} index={index} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeading kicker={t.sections.timelineKicker} title={t.sections.timelineTitle} />
      <div class="timeline-grid">
        {t.timeline.map((item) => (
          <article class="timeline-item">
            <time>{item.period}</time>
            <h3>{item.title}</h3>
            <strong>{item.meta}</strong>
            <p>{item.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeading
        kicker={t.sections.writingKicker}
        title={t.sections.writingTitle}
        href={`/${lang}/writing/`}
        linkLabel={t.sections.viewAll}
      />
      <div class="writing-layout">
        <div class="article-list">
          {writing.map((entry) => (
            <article class="article-card">
              <time datetime={entry.data.publishedAt.toISOString()}>
                {entry.data.readingMinutes} MIN
              </time>
              <div>
                <h3><a href={`/${lang}/writing/${entry.data.slug}/`}>{entry.data.title}</a></h3>
                <p>{entry.data.summary}</p>
                <div class="tag-row">{entry.data.tags.map((tag) => <span>#{tag}</span>)}</div>
              </div>
            </article>
          ))}
        </div>
        <div>
          <div class="platform-list">
            {platforms[lang].map((platform) => (
              <article class="platform-card">
                <div class="platform-label"><span>{platform.name}</span><span>↗</span></div>
                <h3><a href={platform.url} target="_blank" rel="noreferrer">{platform.handle}</a></h3>
                <p>{platform.note}</p>
                <div class="platform-metrics">{platform.metrics.map((metric) => <span>{metric}</span>)}</div>
              </article>
            ))}
          </div>
          <p class="data-note">{t.dataNote}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeading
        kicker={t.sections.awardsKicker}
        title={t.sections.awardsTitle}
        href={`/${lang}/about/#recognition`}
        linkLabel={t.sections.viewAll}
      />
      <AwardGallery entries={awards.slice(0, 6)} lang={lang} />
    </div>
  </section>

  <ContactPanel lang={lang} />
</BaseLayout>
