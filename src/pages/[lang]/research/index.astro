---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PublicationCard from "@/components/PublicationCard.astro";
import ContactPanel from "@/components/ContactPanel.astro";
import "@/styles/editorial-pages.css";
import { copy, languages } from "@/lib/i18n";
import { getLocalizedCollection } from "@/lib/content";
import type { Lang } from "@/lib/models";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const t = copy[lang];
const publications = (await getLocalizedCollection("publications", lang))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.year - a.data.year);
const filters = [
  ["all", lang === "zh" ? "全部成果" : "All"],
  ["published", lang === "zh" ? "已发表" : "Published"],
  ["under_review", lang === "zh" ? "审稿中" : "Under Review"],
  ["shared_task", lang === "zh" ? "共享任务" : "Shared Tasks"],
  ["manuscript", lang === "zh" ? "研究稿件" : "Manuscripts"]
];
const researchStats = [
  [String(publications.length), lang === "zh" ? "项研究记录" : "research records"],
  [
    String(publications.filter((entry) => ["published", "accepted"].includes(entry.data.status)).length),
    lang === "zh" ? "已发表 / 录用" : "published / accepted"
  ],
  [
    String(publications.filter((entry) => entry.data.status === "under_review").length),
    lang === "zh" ? "审稿中" : "under review"
  ],
  [
    String(publications.filter((entry) => entry.data.status === "shared_task").length),
    lang === "zh" ? "共享任务系统" : "shared-task systems"
  ]
];
---

<BaseLayout
  lang={lang}
  title={lang === "zh" ? "研究成果｜黄彬" : "Research | Bin Huang"}
  description={t.sections.researchBody}
  image="/og.png"
  editorial
>
  <header class="page-hero editorial-page-hero">
    <div class="shell">
      <div class="editorial-marker">01 / RESEARCH</div>
      <h1>{lang === "zh" ? "我在研究什么，以及每项工作具体做了什么" : "What I study, and what I contributed to each piece of work"}</h1>
      <p>
        {lang === "zh"
          ? "这里收录论文、共享任务和研究稿件。状态、作者角色和结果指标都按目前能公开的证据填写。"
          : "This page collects papers, shared-task systems, and manuscripts. Status, authorship, and results follow the evidence I can currently make public."}
      </p>
      <div class="editorial-hero-stats" aria-label={lang === "zh" ? "研究概览" : "Research overview"}>
        {researchStats.map(([value, label]) => (
          <span><strong>{value}</strong><small>{label}</small></span>
        ))}
      </div>
    </div>
  </header>

  <section class="section editorial-index-section">
    <div class="shell">
      <div class="filter-bar" role="group" aria-label={lang === "zh" ? "筛选论文状态" : "Filter publication status"}>
        {filters.map(([value, label], index) => (
          <button type="button" data-filter={value} aria-pressed={index === 0 ? "true" : "false"}>{label}</button>
        ))}
      </div>
      <div class="publication-grid research-list">
        {publications.map((entry) => <PublicationCard entry={entry} lang={lang} compact />)}
      </div>
    </div>
  </section>

  <ContactPanel lang={lang} />

  <script>
    const filterButtons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const cards = document.querySelectorAll<HTMLElement>(".research-list [data-status]");
    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.dataset.filter || "all";
        filterButtons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
        cards.forEach((card) => {
          card.hidden = filter !== "all" && card.dataset.status !== filter;
        });
      });
    });
  </script>
</BaseLayout>
