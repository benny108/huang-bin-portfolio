---
interface Props {
  kicker: string;
  title: string;
  body?: string;
  href?: string;
  linkLabel?: string;
}

const { kicker, title, body, href, linkLabel } = Astro.props;
---

<div class="section-heading">
  <div>
    <div class="kicker">{kicker}</div>
    <h2>{title}</h2>
    {body && <p>{body}</p>}
  </div>
  {href && linkLabel && <a class="text-link" href={href}>{linkLabel}<span aria-hidden="true">↗</span></a>}
</div>
