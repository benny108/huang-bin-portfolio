---
import type { CollectionEntry } from "astro:content";
import { entryHref } from "@/lib/content";
import { copy } from "@/lib/i18n";
import type { Lang } from "@/lib/models";

interface Props {
  entry: CollectionEntry<"projects">;
  lang: Lang;
  index: number;
}

const { entry, lang, index } = Astro.props;
const d = entry.data;
---

<article class={`project-card accent-${d.accent}`}>
  <div class="project-index">0{index + 1}</div>
  <div class="project-main">
    <div class="card-topline">
      <span>{d.role}</span>
      <span>{d.period}</span>
    </div>
    <h3>{d.title}</h3>
    <p>{d.summary}</p>
    <div class="project-metrics">
      {d.metrics.map((metric) => <span>{metric}</span>)}
    </div>
    <a class="text-link" href={entryHref(lang, "projects", d.slug)}>
      {copy[lang].sections.readCase}<span aria-hidden="true">→</span>
    </a>
  </div>
</article>
